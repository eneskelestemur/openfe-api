    given-names: Enes
version: 0.1.0
date-released: "2026-10-03"
license: MIT
repository-code: https://github.com/eneskelestemur/openfe-api
url: https://eneskelestemur.github.io/openfe-api/
keywords:
  - free energy
  - openfe
  - molecular dynamics
  - alchemistry
