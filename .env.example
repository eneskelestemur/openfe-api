# Configuration for the openfe-api service.
#
# Copy to .env and edit, or pass these as environment variables to the container.
# Every setting is optional; the defaults are shown.

# Directory holding one subdirectory per campaign.
OPENFE_API_ROOT=campaigns

# YAML file of execution profiles. Unset means only the built-in "local" profile exists.
# OPENFE_API_PROFILES_FILE=/data/profiles.yaml

# Processes used for partial charge generation during planning. AM1BCC takes minutes per
# drug-sized molecule, so raise this on a machine with spare cores.
OPENFE_API_PROCESSORS=1

# Whether preparation checks that each prepared protein parametrizes with the force field.
# Leave on: it costs seconds and catches problems before any GPU time is spent.
OPENFE_API_CHECK_PARAMETERS=true

# Largest total size one campaign upload may carry, in bytes. 100 MiB by default.
OPENFE_API_MAX_UPLOAD_BYTES=104857600

# Port the container's service listens on; read by the container recipes, not the library.
# OPENFE_API_PORT=8000
